{
  "name": "timetracker",
  "version": "1.0.0",
  "description": "Personal time tracker for long-running projects (works offline, phone + computer)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite build && vite preview",
    "test": "vitest run",
    "icons": "pwa-assets-generator --preset minimal-2023 public/logo.svg"
  },
  "dependencies": {
    "idb": "^8.0.4"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^2.0.0",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
